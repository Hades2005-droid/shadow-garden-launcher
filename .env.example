# Copy to ~/ShadowGarden/.env and fill locally if you do not want to use existing env files.
XAI_API_KEY=
GROK_VOICE_MODEL=grok-voice-latest
GROK_TRANSLATION_MODEL=grok-2
PERPLEXITY_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# --- NWW Asana Connector (optional, additive reporting) ---
# Leave ASANA_ACCESS_TOKEN blank to keep Asana reporting disabled.
# Shadow Garden remains Jira-first; Asana only activates when a token is set.
ASANA_ACCESS_TOKEN=
ASANA_WORKSPACE_ID=
ASANA_PROJECT_SHADOWGARDEN=
# Optional API base override (defaults to https://app.asana.com/api/1.0)
ASANA_BASE_URL=
